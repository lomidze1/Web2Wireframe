{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/shared/src/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "inputs": ["src/**", "api/**", "lib/**", "models/**", "utils/**", "public/**", "manifest.json", "*.config.ts", "*.config.mjs", "*.config.js", "tsconfig.json", "package.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
