{
  "name": "Web2Wireframe",
  "description": "Figma plugin for converting websites to wireframes",
  "model": "sonnet",
  "mcpServers": {
    "figma-desktop": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    }
  },
  "context": {
    "include": ["CLAUDE.md", "README.md", "package.json", "turbo.json"],
    "exclude": [
      "node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/*.log",
      ".DS_Store"
    ]
  },
  "services": {
    "shared": {
      "path": "packages/shared",
      "entry": "src/index.ts",
      "stack": ["TypeScript", "tsup"]
    },
    "api": {
      "path": "packages/api",
      "port": 3002,
      "entry": "src/index.ts",
      "stack": ["Express", "TypeScript", "MongoDB", "Puppeteer", "Claude AI"],
      "endpoints": ["/api/*", "/web/*", "/auth/figma/*"]
    },
    "web": {
      "path": "packages/web",
      "port": 80,
      "entry": "src/main.tsx",
      "stack": ["React 19", "Vite 7", "SSG", "SCSS"]
    },
    "figma-plugin": {
      "path": "packages/figma-plugin",
      "entry": "src/main.ts",
      "stack": ["Preact", "Figma Plugin API", "TypeScript"]
    },
    "browser-extension": {
      "path": "packages/browser-extension",
      "entry": "src/background/index.ts",
      "stack": ["Preact", "Vite", "Chrome DevTools Protocol"],
      "purpose": "CDP-based website capture for 1:1 quality extraction"
    }
  },
  "scripts": {
    "dev": "docker compose up -d",
    "build": "pnpm build",
    "typecheck": "pnpm type-check",
    "test": "pnpm test"
  },
  "codeStyle": {
    "typescript": {
      "strict": true,
      "noAny": true
    },
    "react": {
      "styling": "SCSS modules"
    },
    "api": {
      "validation": "Zod",
      "errorHandling": "Express middleware"
    },
    "database": {
      "type": "MongoDB",
      "indexing": "userId fields"
    }
  },
  "commitConvention": {
    "types": ["feat", "fix", "refactor", "docs", "test"],
    "format": "type: short description",
    "coAuthor": "Claude <noreply@anthropic.com>"
  },
  "workflow": {
    "interviewBeforeCoding": true,
    "verifyAfterChanges": true,
    "commands": {
      "preCommit": "pnpm build && pnpm test"
    }
  },
  "extractionStrategy": {
    "primary": "CDP (Chrome DevTools Protocol)",
    "fallback": "Puppeteer",
    "quality": "1:1 maximum fidelity like html.to.design",
    "critical": {
      "NEVER_USE_ONLY": "getComputedStyle() - loses gradients, CSS vars, hover states",
      "ALWAYS_USE": "CSS.getMatchedStylesForNode - preserves original CSS rules",
      "KEY_CDP_METHODS": [
        "DOM.getDocument",
        "CSS.getMatchedStylesForNode",
        "CSS.getComputedStyleForNode",
        "CSS.getPlatformFontsForNode"
      ]
    },
    "browserExtension": {
      "location": "packages/browser-extension/src/background/cdp/",
      "mainFile": "css.ts",
      "keyFunction": "getMatchedStylesForNode"
    }
  }
}
