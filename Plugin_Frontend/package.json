{
  "name": "plugin-frontend",
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "1.109.0",
    "typescript": ">=5",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "dev": "build-figma-plugin --typecheck --watch",
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "figma-plugin": {
    "editorType": [
      "figma"
    ],
    "id": "w2w-plugin",
    "name": "web2wireframe",
    "main": "src/main.ts",
    "ui": "src/ui/index.tsx",
    "networkAccess": {
      "allowedDomains": [
        "https://license.web2wireframe.design",
        "https://api.web2wireframe.design"
      ],
      "devAllowedDomains": [
        "http://localhost:3001",
        "http://localhost:3002",
        "http://localhost:3003"
      ]
    }
  }
}
