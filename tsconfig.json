{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/api/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "packages/web", "packages/figma-plugin", "packages/browser-extension"]
}
