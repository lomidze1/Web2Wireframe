{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "Website_Frontend/src/**/*.ts",
    "Website_Frontend/src/**/*.tsx",
    "Website_Backend/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
