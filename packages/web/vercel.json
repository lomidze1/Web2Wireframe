{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm build --filter @w2w/web",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/pricing", "destination": "/", "permanent": true },
    { "source": "/checkout", "destination": "/", "permanent": true },
    { "source": "/checkout/:path*", "destination": "/", "permanent": true },
    { "source": "/renew", "destination": "/", "permanent": true },
    { "source": "/account", "destination": "/", "permanent": true },
    { "source": "/signin", "destination": "/", "permanent": true },
    { "source": "/screenshot-to-figma", "destination": "/website-to-figma", "permanent": true },
    { "source": "/docs/pricing/:path*", "destination": "/", "permanent": true },
    { "source": "/docs/import-methods/screenshot-import", "destination": "/docs", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.web2wireframe.design/api/$1" },
    { "source": "/web/(.*)", "destination": "https://api.web2wireframe.design/web/$1" },
    { "source": "/auth/(.*)", "destination": "https://api.web2wireframe.design/auth/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
