{
  "name": "web2wireframe-extension",
  "version": "1.0.0",
  "description": "Chrome extension for Web2Wireframe - CDP-based website capture",
  "type": "module",
  "scripts": {
    "dev": "tsc && vite build --watch",
    "build": "tsc && vite build && vite build --config vite.config.content.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@w2w/shared": "workspace:*",
    "preact": "^10.19.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.0.260",
    "happy-dom": "^20.9.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
