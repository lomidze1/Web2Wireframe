{
  "name": "@w2w/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified backend API for Web2Wireframe",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
