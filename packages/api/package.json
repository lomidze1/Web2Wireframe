    "test": "vitest run",
    "test:e2e:flitt": "tsx scripts/e2e-flitt-webhook.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@w2w/shared": "workspace:*",
    "axios": "^1.15.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "jsdom": "^23.0.1",
    "mongoose": "^8.0.0",
    "puppeteer": "^21.4.0",
    "resend": "^2.0.0",
    "sharp": "^0.34.5",
    "wawoff2": "^2.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/express-session": "^1.18.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "devtools-protocol": "^0.0.1604597",
    "supertest": "^7.2.2",
