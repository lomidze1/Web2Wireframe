{
  "name": "@w2w/shared",
  "version": "1.0.0",
  "description": "Shared types and CDP extraction logic for Web2Wireframe",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./content-script-bundle": {
      "import": {
        "types": "./dist/content-script-bundle.d.ts",
        "default": "./dist/content-script-bundle.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node ../../scripts/bundle-content-script.mjs",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
