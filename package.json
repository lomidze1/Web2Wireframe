{
  "name": "web2wireframe",
  "version": "2.0.0",
  "description": "Web2Wireframe - Convert websites to Figma wireframes with AI-powered design system",
  "homepage": "https://web2wireframe.design",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/web2wireframe"
  },
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer",
      "@parcel/watcher",
      "sharp"
    ],
    "overrides": {
      "ws@<8.20.1": "^8.20.1",
      "basic-ftp@<=5.3.0": "^5.3.1",
      "tar-fs@>=3.0.0 <3.1.1": "^3.1.1",
      "path-to-regexp@<0.1.13": "0.1.13",
      "happy-dom@<20.8.9": "^20.8.9",
      "brace-expansion@<1.1.13": "^1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "brace-expansion@>=5.0.0 <5.0.6": "^5.0.6",
      "postcss@<8.5.10": "^8.5.10",
      "ip-address@<=10.1.0": "^10.1.1",
      "js-cookie@<=3.0.5": "^3.0.7",
      "qs@>=6.11.1 <=6.15.1": "^6.15.2"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "dev:local": "turbo dev --continue",
    "dev:api": "pnpm --filter @w2w/api dev",
    "dev:web": "pnpm --filter @w2w/web dev",
    "dev:shared": "pnpm --filter @w2w/shared dev",
    "dev:plugin": "pnpm --filter plugin-frontend dev",
    "dev:extension": "pnpm --filter web2wireframe-extension dev",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test": "turbo test",
    "start": "pnpm --filter @w2w/api start",
    "clean": "rm -rf node_modules **/node_modules .turbo **/.turbo **/dist",
    "reset": "pnpm clean && pnpm install && pnpm build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "rebuild-start": "pnpm build && docker compose build && docker compose up -d",
    "rebuild-start:local": "pnpm build && turbo dev --continue"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "turbo": "^2.9.14",
    "typescript-eslint": "^8.57.2"
  },
  "keywords": [
    "figma",
    "wireframe",
    "website",
    "conversion",
    "design",
    "ai",
    "plugin"
  ],
  "author": "Web2Wireframe",
  "license": "MIT"
}
