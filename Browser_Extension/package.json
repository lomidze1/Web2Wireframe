{
  "name": "web2wireframe-extension",
  "version": "1.0.0",
  "description": "Chrome extension for Web2Wireframe - CDP-based website capture",
  "type": "module",
  "scripts": {
    "dev": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "preact": "^10.19.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@types/chrome": "^0.0.260",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
