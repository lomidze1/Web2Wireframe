# Server
PORT=3001
NODE_ENV=development

# CORS (comma-separated)
ALLOWED_ORIGIN=http://localhost:5173,https://www.web2wireframe.design

# Session
SESSION_SECRET=change-me-in-production

# Email (Support form)
RESEND_API_KEY=your_resend_api_key
SUPPORT_TO_EMAIL=support@yourdomain.com
NOREPLY_EMAIL=no-reply@yourdomain.com

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=5

# Figma OAuth
FIGMA_CLIENT_ID=your_figma_client_id
FIGMA_CLIENT_SECRET=your_figma_client_secret
# Optional override; must match a registered redirect URI
FIGMA_REDIRECT_URI=http://localhost:3001/auth/figma/callback

# License service proxy
LICENSE_SERVICE_URL=https://web2wireframe.onrender.com
LICENSE_SERVICE_TOKEN=dev-token
