# === Server ===
API_PORT=3002
NODE_ENV=development

# Number of trusted reverse-proxy hops in front of the API. Express uses this
# to compute `req.ip` from `X-Forwarded-For`. Wrong values let attackers
# spoof real client IPs via forged XFF headers, defeating the Flitt IP
# allowlist AND making per-IP rate-limiting useless.
#   - Local dev (no proxy):                  TRUST_PROXY_HOPS=0
#   - Single nginx / Vercel:                 TRUST_PROXY_HOPS=1
#   - Cloudflare → Render / Cloudflare → ALB:TRUST_PROXY_HOPS=2
# Valid range: 0..5. Default if unset: 1.
TRUST_PROXY_HOPS=1

# === MongoDB ===
MONGODB_URI=mongodb://mongo:27017/web2wireframe

# === Auth ===
# Generate strong unique values, e.g.  openssl rand -hex 32
# The API refuses to boot in production if these are left as placeholders.
AUTH_SECRET=__REPLACE_WITH_openssl_rand_-hex_32__
SESSION_SECRET=__REPLACE_WITH_openssl_rand_-hex_32__

# === AI (Claude) ===
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-20250514

# === Puppeteer ===
PUPPETEER_TIMEOUT=30000

# === Email (Resend) ===
RESEND_API_KEY=
SUPPORT_TO_EMAIL=support@web2wireframe.design
NOREPLY_EMAIL=no-reply@web2wireframe.design
# Resend Audience ID for newsletter signups (browser extension Help Modal).
# Leave blank to disable — /api/newsletter/subscribe returns 503 instead of
# silently dropping signups.
RESEND_AUDIENCE_ID=

# === Figma OAuth ===
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3002/auth/figma/callback

# === License Admin ===
# Generate a strong unique value, e.g.  openssl rand -hex 32
ADMIN_TOKEN=__REPLACE_WITH_openssl_rand_-hex_32__
DEV_TOKEN=__REPLACE_WITH_A_DEV_ONLY_TOKEN__

# === CORS ===
# CORS_ORIGIN applies to /api/* (plugin + Account page CORS preflights).
# Includes both Figma plugin origins and the website's own origin so the
# Account page can call /api/license/me and /api/subscription/cancel.
CORS_ORIGIN=http://localhost:5173,https://www.figma.com,https://www.web2wireframe.design

# Our browser extension's id, so its popup (Origin: chrome-extension://<id>)
# can call /api/* (e.g. the newsletter form). Set to the published Chrome Web
# Store id. Leave empty to disallow all extension origins.
EXTENSION_ID=
WEBSITE_ALLOWED_ORIGINS=http://localhost:5173,https://www.web2wireframe.design

# === Flitt (payment processor) ===
# Get from Flitt merchant dashboard at https://flitt.com/
# Sandbox/live switch is implicit via the credential pair.
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
FLITT_BASE_URL=https://pay.flitt.com
# Webhook source-IP allowlist (M-8). In production this is ENABLED by default
# regardless of this flag; set to "false" only as an emergency escape during a
# Flitt-side IP rotation. Outside production the default is OFF.
# FLITT_IP_ALLOWLIST_ENABLED=true
# Optional comma-separated override for the IP list (defaults to Flitt's
# documented production IPs: 54.154.216.60, 3.75.125.89).
# FLITT_WEBHOOK_IPS=54.154.216.60,3.75.125.89

# === Public URLs (production) ===
# API_PUBLIC_URL is the parent of the Flitt webhook callback
# (server_callback_url = `${API_PUBLIC_URL}/api/webhooks/flitt`).
# The API refuses to boot in production (NODE_ENV=production) without
# an https value here — startupChecks.assertProductionUrls rejects
# missing / non-https / localhost values.
API_PUBLIC_URL=https://api.web2wireframe.design

# === Website base URL (for checkout redirects + cancel page) ===
WEBSITE_BASE_URL=http://localhost:5173

# === Expiry reminder emails ===
# Daily-ish job that emails one-time Pro users ~3 days before access lapses.
# Set to "false" to disable; any other value (or unset) leaves it enabled.
EXPIRY_REMINDERS_ENABLED=true
