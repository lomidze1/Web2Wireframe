# === Server ===
API_PORT=3002
NODE_ENV=development

# === MongoDB ===
MONGODB_URI=mongodb://mongo:27017/web2wireframe

# === Auth ===
AUTH_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production

# === AI (Claude) ===
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-20250514

# === Puppeteer ===
PUPPETEER_TIMEOUT=30000

# === Email (Resend) ===
RESEND_API_KEY=
SUPPORT_TO_EMAIL=support@web2wireframe.design
NOREPLY_EMAIL=no-reply@web2wireframe.design

# === Figma OAuth ===
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3002/auth/figma/callback

# === License Admin ===
ADMIN_TOKEN=admin-token
DEV_TOKEN=dev-token

# === CORS ===
# CORS_ORIGIN applies to /api/* (plugin + Account page CORS preflights).
# Includes both Figma plugin origins and the website's own origin so the
# Account page can call /api/license/me and /api/subscription/cancel.
CORS_ORIGIN=http://localhost:5173,https://www.figma.com,https://www.web2wireframe.design
WEBSITE_ALLOWED_ORIGINS=http://localhost:5173,https://www.web2wireframe.design

# === Flitt (payment processor) ===
# Get from Flitt merchant dashboard at https://flitt.com/
# Sandbox/live switch is implicit via the credential pair.
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
FLITT_BASE_URL=https://pay.flitt.com

# === Website base URL (for checkout redirects + cancel page) ===
WEBSITE_BASE_URL=http://localhost:5173
